  "components": {
    "schemas": {
      "BenchmarkSnapshotResponse": {
        "type": "object",
        "required": [
          "sequence",
          "label",
          "query_rows",
          "query_rows_limit",
          "query_rows_delta",
          "heap_size_pct",
          "heap_size_bytes_limit",
          "heap_size_delta",
          "cpu_time_ms",
          "cpu_time_limit",
          "cpu_time_delta",
          "dml_statements",
          "dml_statements_limit",
          "soql_queries",
          "soql_queries_limit"
        ],
        "properties": {
          "cpu_time_delta": {
            "type": "integer",
            "format": "int64"
          },
          "cpu_time_limit": {
            "type": "integer",
            "format": "int64"
          },
          "cpu_time_ms": {
            "type": "integer",
            "format": "int64"
          },
          "dml_statements": {
            "type": "integer",
            "format": "int64"
          },
          "dml_statements_limit": {
            "type": "integer",
            "format": "int64"
          },
          "heap_size_bytes_limit": {
            "type": "integer",
            "format": "int64"
          },
          "heap_size_delta": {
            "type": "number",
            "format": "double"
          },
          "heap_size_pct": {
            "type": "number",
            "format": "double"
          },
          "label": {
            "type": "string"
          },
          "query_rows": {
            "type": "integer",
            "format": "int64"
          },
          "query_rows_delta": {
            "type": "integer",
            "format": "int64"
          },
          "query_rows_limit": {
            "type": "integer",
            "format": "int64"
          },
          "sequence": {
            "type": "integer",
            "format": "int32"
          },
          "soql_queries": {
            "type": "integer",
            "format": "int64"
          },
          "soql_queries_limit": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CreateOrgRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "properties": {
          "database": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "done",
          "failed"
        ]
      },
      "LicenseSnapshot": {
        "type": "object",
        "required": [
          "tier",
          "status",
          "features"
        ],
        "properties": {
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "$ref": "#/components/schemas/LicenseStatus"
          },
          "tier": {
            "$ref": "#/components/schemas/LicenseTier"
          }
        }
      },
      "LicenseStatus": {
        "type": "string",
        "enum": [
          "active",
          "past_due",
          "canceled"
        ]
      },
      "LicenseTier": {
        "type": "string",
        "enum": [
          "free",
          "pro",
          "enterprise"
        ]
      },
      "ListBenchmarksResponse": {
        "type": "object",
        "required": [
          "benchmarks"
        ],
        "properties": {
          "benchmarks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BenchmarkSnapshotResponse"
            }
          }
        }
      },
      "ListEventsQuery": {
        "type": "object",
        "properties": {
          "event_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "log_level": {
            "type": [
              "string",
              "null"
            ]
          },
          "offset": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "search": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ListEventsResponse": {
        "type": "object",
        "required": [
          "events",
          "total"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LogEventResponse"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ListJobsQuery": {
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ListJobsResponse": {
        "type": "object",
        "required": [
          "jobs"
